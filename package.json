{
  "name": "tcss460-moviewebapi",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
  "dev": "tsx src/index.ts",
  "build": "tsc",
  "start": "node dist/index.js",
  "postinstall": "npm run build",
    "typecheck": "tsc --noEmit",
    "setup:db": "tsx data/setup_db.ts && node data/import_movies_csv.js",
    "setup:db:clean": "tsx data/setup_db.ts",
    "setup:db:import": "node data/import_movies_csv.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "path": "^0.12.7",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.24",
    "@types/node": "^20.19.23",
    "@types/sqlite3": "^3.1.11",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/yamljs": "^0.2.34",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.0.0"
  }
}
