      {
        "name": "API Key Security",
        "item": [
          {
            "name": "No API Key - Should Fail",
            "request": {
              "method": "GET",
              "header": [],
              "url": { "raw": "{{base_url}}/movies", "host": ["{{base_url}}"], "path": ["movies"] },
              "description": "Expected 401 Unauthorized when no API key sent."
            },
            "response": []
          },
          {
            "name": "Invalid API Key - Should Fail",
            "request": {
              "method": "GET",
              "header": [{ "key": "X-API-Key", "value": "invalid_key", "type": "text" }],
              "url": { "raw": "{{base_url}}/movies", "host": ["{{base_url}}"], "path": ["movies"] },
              "description": "Expected 401 Unauthorized with wrong API key."
            },
            "response": []
          },
          {
            "name": "Valid API Key - Should Pass",
            "request": {
              "method": "GET",
              "header": [{ "key": "X-API-Key", "value": "{{api_key}}", "type": "text" }],
              "url": { "raw": "{{base_url}}/movies", "host": ["{{base_url}}"], "path": ["movies"] },
              "description": "Expected 200 OK with valid key."
            },
            "response": []
          }
        ]
      },
      {
        "name": "Full CRUD Flow",
        "item": [
          {
            "name": "Create Movie (for flow)",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "if (pm.response.code === 201) {",
                    "  var json = pm.response.json();",
                    "  pm.collectionVariables.set('flow_movie_id', json.movie_id);",
                    "  pm.test('Movie created', function() { pm.expect(json.title).to.eql('Flow Movie'); });",
                    "}"
                  ],
                  "type": "text/javascript"
                }
              }
            ],
            "request": {
              "method": "POST",
              "header": [
                { "key": "X-API-Key", "value": "{{api_key}}", "type": "text" },
                { "key": "Content-Type", "value": "application/json", "type": "text" }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"title\": \"Flow Movie\",\n  \"release_date\": \"2024-10-01\",\n  \"runtime_in_minutes\": 120\n}"
              },
              "url": { "raw": "{{base_url}}/movies", "host": ["{{base_url}}"], "path": ["movies"] },
              "description": "Creates a temporary movie for full CRUD test."
            },
            "response": []
          },
          {
            "name": "Get Movie (flow)",
            "request": {
              "method": "GET",
              "header": [{ "key": "X-API-Key", "value": "{{api_key}}", "type": "text" }],
              "url": { "raw": "{{base_url}}/movies/{{flow_movie_id}}", "host": ["{{base_url}}"], "path": ["movies", "{{flow_movie_id}}"] },
              "description": "Verify movie created in previous step."
            },
            "response": []
          },
          {
            "name": "Delete Movie (flow)",
            "request": {
              "method": "DELETE",
              "header": [{ "key": "X-API-Key", "value": "{{api_key}}", "type": "text" }],
              "url": { "raw": "{{base_url}}/movies/{{flow_movie_id}}", "host": ["{{base_url}}"], "path": ["movies", "{{flow_movie_id}}"] },
              "description": "Clean up test data."
            },
            "response": []
          }
        ]
      },
