      {
        "name": "Genres",
        "item": [
          {
            "name": "Get All Genres",
            "request": {
              "method": "GET",
              "header": [
                { "key": "X-API-Key", "value": "{{api_key}}", "type": "text" }
              ],
              "url": {
                "raw": "{{base_url}}/genres",
                "host": ["{{base_url}}"],
                "path": ["genres"]
              },
              "description": "Returns all genres."
            },
            "response": []
          },
          {
            "name": "Create Genre",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "if (pm.response.code === 201) {",
                    "  var jsonData = pm.response.json();",
                    "  pm.collectionVariables.set('test_genre_id', jsonData.genre_id);",
                    "  pm.test('Genre created successfully', function () {",
                    "    pm.expect(jsonData.genre_name).to.eql('Test Genre');",
                    "  });",
                    "}"
                  ],
                  "type": "text/javascript"
                }
              }
            ],
            "request": {
              "method": "POST",
              "header": [
                { "key": "X-API-Key", "value": "{{api_key}}", "type": "text" },
                { "key": "Content-Type", "value": "application/json", "type": "text" }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"genre_name\": \"Test Genre\"\n}"
              },
              "url": {
                "raw": "{{base_url}}/genres",
                "host": ["{{base_url}}"],
                "path": ["genres"]
              },
              "description": "Creates a new genre for testing."
            },
            "response": []
          },
          {
            "name": "Get Genre by ID",
            "request": {
              "method": "GET",
              "header": [
                { "key": "X-API-Key", "value": "{{api_key}}", "type": "text" }
              ],
              "url": {
                "raw": "{{base_url}}/genres/{{test_genre_id}}",
                "host": ["{{base_url}}"],
                "path": ["genres", "{{test_genre_id}}"]
              },
              "description": "Get the genre we just created."
            },
            "response": []
          },
          {
            "name": "Update Genre",
            "request": {
              "method": "PUT",
              "header": [
                { "key": "X-API-Key", "value": "{{api_key}}", "type": "text" },
                { "key": "Content-Type", "value": "application/json", "type": "text" }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"genre_name\": \"Updated Test Genre\"\n}"
              },
              "url": {
                "raw": "{{base_url}}/genres/{{test_genre_id}}",
                "host": ["{{base_url}}"],
                "path": ["genres", "{{test_genre_id}}"]
              },
              "description": "Update the test genre name."
            },
            "response": []
          },
          {
            "name": "Delete Genre",
            "request": {
              "method": "DELETE",
              "header": [
                { "key": "X-API-Key", "value": "{{api_key}}", "type": "text" }
              ],
              "url": {
                "raw": "{{base_url}}/genres/{{test_genre_id}}",
                "host": ["{{base_url}}"],
                "path": ["genres", "{{test_genre_id}}"]
              },
              "description": "Delete the test genre we created."
            },
            "response": []
          },
