              "url": { "raw": "{{base_url}}/movies", "host": ["{{base_url}}"], "path": ["movies"] },
              "description": "Should return 400 Bad Request (missing title)."
            },
            "response": []
          },
          {
            "name": "Update Movie - Invalid ID",
            "request": {
              "method": "PUT",
              "header": [
                { "key": "X-API-Key", "value": "{{api_key}}", "type": "text" },
                { "key": "Content-Type", "value": "application/json", "type": "text" }
              ],
              "body": { "mode": "raw", "raw": "{\n  \"title\": \"Invalid Movie\"\n}" },
              "url": { "raw": "{{base_url}}/movies/999999", "host": ["{{base_url}}"], "path": ["movies", "999999"] },
              "description": "Should return 404 Not Found for non-existent movie."
            },
            "response": []
